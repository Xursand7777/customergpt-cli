{
  "name": "@customergpt/cli",
  "version": "0.7.0",
  "description": "Official CustomerGPT CLI — create, train, test and install AI support bots from your terminal and AI agents.",
  "type": "module",
  "bin": {
    "customergpt": "bin/customergpt.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "@customergpt/sdk": "^0.1.2"
  },
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "customergpt",
    "cli",
    "mcp",
    "chatbot",
    "ai",
    "ai-agent",
    "customer-support",
    "knowledge-base",
    "support-automation"
  ],
  "homepage": "https://customergpt.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xursand7777/customergpt-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Xursand7777/customergpt-cli/issues",
    "email": "support@customergpt.ai"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
